src payload.hex1

; === offset 0: прыжок через таблицу указателей ===
19 A0           ; c.j :code  (+6)

; === offset 2: таблица указателей (4-байтовое относительное смещение) ===
%hello

; === offset 6: код ===
:code
97 02 00 00     ; auipc t0, 0        → t0 = PC = file_base + 6
93 82 C2 FF     ; addi t0, t0, -4   → t0 = file_base + 2 = адрес %hello
03 A5 02 00     ; lw a0, 0(t0)      → a0 = 32-bit relative offset (sign-extended)
93 82 42 00     ; addi t0, t0, 4    → t0 = file_base + 6
B3 04 55 00     ; add s1, a0, t0    → s1 = offset + (base+6) = abs addr :hello

; === offset 26: цикл печати ===
:loop
03 85 04 00     ; lb a0, 0(s1)
09 C5           ; beqz a0, :halt    (+10 → offset 40)
85 04           ; addi s1, s1, 1
EF 00 80 00     ; jal ra, :uart_putc (+8  → offset 42)
D5 BF           ; j :loop           (-12 → offset 26)

:halt
01 A0           ; j :halt

:uart_putc
B7 05 00 10     ; lui a1, 0x10000
23 80 A5 00     ; sb a0, 0(a1)
82 80           ; ret

:hello
48 65 6C 6C 6F 2C 20 57 6F 72 6C 64 21 0A 00    ; "Hello, World!\n"
